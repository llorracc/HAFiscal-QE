  - "Figures/@local"
  - "Figures/@resources"
  - "Tables/@local"
  - "Tables/@resources"
  - "Subfiles/@local"
  - "Subfiles/@resources"
  - "*-titlepage.pdf"
  - "HAFiscal_paperpile*.*"

  # --- TeX resources / local install (large, not source) ---
  - "@local/"
  - "@resources/"
  - "pkgs/"

  # --- Generated / build artifacts ---
  - "build/"
  - "dist/"
  - "*.egg-info/"
  - "*.whl"
  - "*.tar.gz"
  - "*.zip"
  - "*.pdf"
  - "_build/"
  - "_site/"
  - ".jekyll-cache/"
  - "docs/_build/"
  - "package-lock.json"
  - "yarn.lock"
  - "uv.lock"
  - "poetry.lock"

  # --- Sensitive / local-only ---
  - ".env"
  - "*.key"
  - "*.pem"
  - "secrets.*"
  - "TODO.md"
  - "notes.md"
  - "personal_*.md"

  # --- Test / sample data ---
  - "test_data/"
  - "sample_data/"
  - "mock_data/"
  - "tests/"
  - "test_*"
  - "*_test.py"

  # --- Large binaries (optional: uncomment if you want to index some images) ---
  - "*.png"
  - "*.jpg"
  - "*.jpeg"
  - "*.gif"
  - "*.svg"
  - "*.mp3"
  - "*.mp4"
  - "*.avi"
  - "*.mov"
  - "*.wav"

  # --- Jupyter ---
  - ".ipynb_checkpoints"

  # --- Repo-specific (user-requested) ---
  - "binder/"
  - "reproduce/"
  - "Highlighted/"
  - "q/"
  - "images/"
  - "Data/"
  - "Code/Empirical/"
  - "prompts/**"
  - "prompts"
  - "prompts_local/**"
  - "qe/**"
  - "branding"
  - "branding/**"
  - "*.dep"

  # --- ChkTeX / aspell / backup (from .gitignore) ---
  - "*.chktex-backup"
  - ".aspell.conf"
  - ".chktexrc"
  - "*pathtmp"

# Master files (index these with higher priority)
master_files:
  - "README.md"
  - "*.md"
  - "*.ipynb"
  - "*.py"
  - "*.tex"
  - "*.yml"
  - "*.yaml"
  - "pyproject.toml"
  - "environment.yml"
  - "setup.py"
  - "requirements.txt"

# Source -> generated (skip generated when source exists)
source_relationships:
  - source: "*.md"
    generates: ["*.pdf", "*.html", "*.docx", "*.tex"]
  - source: "*.py"
    generates: ["*.pyc", "__pycache__/*"]
  - source: "*.tex"
    generates: ["*.aux", "*.log", "*.out", "*.toc", "*.bbl", "*.blg", "*.4ct", "*.4tc", "*.html", "*.xref"]
  - source: "*.ipynb"
    generates: ["*.html", "*.pdf", "*.py"]

# Careful processing (size/import limits)
careful_processing:
  config_files:
    patterns: ["*.yml", "*.yaml", "*.toml", "*.ini", "*.cfg", "Dockerfile", "docker-compose.yml", "requirements.txt", "setup.py", "pyproject.toml"]
    max_size_kb: 100
  data_files:
    patterns: ["*.csv", "*.json", "*.xlsx", "*.xls"]
    max_size_kb: 50
  code_files:
    import_threshold: 0.8
    skip_generated: true
    skip_templates: false
  large_notebooks:
    patterns: ["*.ipynb"]
    max_size_mb: 2
    strip_outputs: true

# --- Repo-specific suggestions (review and uncomment if desired) ---
# - "README/"            # If this is generated or duplicate of README.md
# - "dashboard/"         # If UI-only, not conceptual content
# - "Figures/"           # Many generated .tex; keep if you want figure source
# - "Tables/"            # Many generated .tex; keep if you want table source
# - "Equations/"         # Generated by verbatimwrite; already ignored above
# - "tabular/"           # If generated
# - "docs/"              # Keep for documentation; or ignore if duplicate of README
# - "qe/"                # QE submission templates; keep or ignore by use case
