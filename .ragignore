# .ragignore for HAFiscal-Latest
# RAG indexing rules: ignore patterns, source priority, and generated-file relationships.
# Combined from: system junk (Win/Linux/macOS/Samba), LaTeX/htlatex/make4ht, Python, Emacs,
# and the repository's .gitignore. Repo-specific suggestions at end.

source_priority:
  - .md
  - .ipynb
  - .py
  - .tex
  - .html
  - .txt
  - .yml
  - .yaml
  - .json
  - .rst

ignore_patterns:
  # --- System junk: Windows ---
  - "Thumbs.db"
  - "ehthumbs.db"
  - "desktop.ini"
  - "*.lnk"
  - "*.LNK"

  # --- System junk: macOS ---
  - ".DS_Store"
  - ".AppleDouble"
  - ".LSOverride"
  - "Icon"
  - "._*"
  - ".DocumentRevisions-V100"
  - ".fseventsd"
  - ".Spotlight-V100"
  - ".TemporaryItems"
  - ".Trashes"
  - ".VolumeIcon.icns"
  - ".com.apple.timemachine.donotpresent"
  - ".AppleDB"
  - ".AppleDesktop"
  - "Network Trash Folder"
  - "Temporary Items"
  - ".apdisk"

  # --- System junk: Linux / Samba ---
  - "*~"
  - ".*.swp"
  - ".*.swo"
  - "*.bak"
  - "*.bak[0-9]"
  - "*.bak[0-9][0-9]"

  # --- Emacs / AUCTeX ---
